rules_version = '2';

// Anyone signed in (the app signs everyone in anonymously) can use a room if
// they know its code. The room code is the password, so pick one that isn't
// easy to guess if you care.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room} {
      allow read, create, update: if request.auth != null;

      match /characters/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.owner == request.auth.uid;
        // Any party member can update (so "Take" works if someone switches
        // devices), but the doc must keep an owner.
        allow update: if request.auth != null
          && request.resource.data.owner is string;
        allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      }

      match /log/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() < 500;
      }

      // Battlefield tokens: anyone in the room can add, move and edit them.
      match /tokens/{id} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.x is number
          && request.resource.data.y is number;
      }

      match /meta/{doc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
